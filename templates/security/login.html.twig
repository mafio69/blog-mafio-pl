{% extends 'base.html.twig' %}

{% block title %}login — blog.mafio.pl{% endblock %}

{% block body %}
    <div style="max-width: 340px; margin: 4rem auto;">
        <h1 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 0.3rem;">login_</h1>
        <p style="font-size: 0.75rem; color: var(--fg-muted); margin-bottom: 2rem;">panel administracyjny</p>

        {% if error %}
            <div style="border: 1px solid #ff333380; background: #1a0a0a; color: #ff5555; padding: 0.6rem 0.8rem; border-radius: 4px; margin-bottom: 1.5rem; font-size: 0.75rem;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <label for="_username" style="display: block; font-size: 0.7rem; color: var(--fg-muted); margin-bottom: 0.3rem;">user</label>
                <input type="text" id="_username" name="_username" value="{{ last_username }}" required autofocus
                    style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--border-hover); border-radius: 4px; font-size: 0.85rem; background: var(--bg-elevated); color: var(--fg); font-family: var(--font); outline: none;"
                    onfocus="this.style.borderColor='var(--fg-muted)'" onblur="this.style.borderColor='var(--border-hover)'">
            </div>
            <div>
                <label for="_password" style="display: block; font-size: 0.7rem; color: var(--fg-muted); margin-bottom: 0.3rem;">pass</label>
                <input type="password" id="_password" name="_password" required
                    style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--border-hover); border-radius: 4px; font-size: 0.85rem; background: var(--bg-elevated); color: var(--fg); font-family: var(--font); outline: none;"
                    onfocus="this.style.borderColor='var(--fg-muted)'" onblur="this.style.borderColor='var(--border-hover)'">
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" style="width: 100%; padding: 0.6rem; background: var(--fg); color: var(--bg); border: none; border-radius: 4px; font-size: 0.8rem; font-weight: 700; cursor: pointer; font-family: var(--font); transition: opacity 0.15s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
                → zaloguj
            </button>
        </form>
    </div>
{% endblock %}

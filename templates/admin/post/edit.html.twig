{% extends 'base.html.twig' %}

{% block title %}{{ post ? 'Edit Post' : 'New Post' }} — Admin{% endblock %}

{% block body %}
    <h1>{{ post ? 'Edit Post' : 'New Post' }}</h1>
    <p><a href="{{ path('admin_post_index') }}">← Back to list</a></p>

    <form method="post" style="display: flex; flex-direction: column; gap: 1rem; max-width: 600px;">
        <div>
            <label for="title" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Title</label>
            <input type="text" id="title" name="title" value="{{ post.title|default('') }}" required style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
        </div>

        <div>
            <label for="slug" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Slug (optional, auto-generated if empty)</label>
            <input type="text" id="slug" name="slug" value="{{ post.slug|default('') }}" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
        </div>

        <div>
            <label for="summary" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Summary</label>
            <textarea id="summary" name="summary" rows="3" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">{{ post.summary|default('') }}</textarea>
        </div>

        <div>
            <label for="content" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Content (Markdown)</label>
            <textarea id="content" name="content" rows="10" required style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-family: monospace;">{{ post.content|default('') }}</textarea>
        </div>

        <div>
            <label for="status" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Status</label>
            <select id="status" name="status" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
                <option value="draft" {{ (post.status|default('draft')) == 'draft' ? 'selected' : '' }}>Draft</option>
                <option value="published" {{ (post.status|default('')) == 'published' ? 'selected' : '' }}>Published</option>
            </select>
        </div>

        <div>
            <label for="tags" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Tags (comma separated)</label>
            <input type="text" id="tags" name="tags" value="{{ post.tags|default([])|join(', ') }}" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
        </div>

        <div>
            <label for="source_urls" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Source URLs (comma separated)</label>
            <input type="text" id="source_urls" name="source_urls" value="{{ post.source_urls|default([])|join(', ') }}" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
        </div>

        <input type="hidden" name="_token" value="{{ csrf_token('post') }}">

        <div>
            <button type="submit" style="padding: 0.7rem 1.5rem; background: #3182ce; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">
                {{ post ? 'Update Post' : 'Create Post' }}
            </button>
        </div>
    </form>
{% endblock %}

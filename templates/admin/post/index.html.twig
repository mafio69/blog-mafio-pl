{% extends 'base.html.twig' %}

{% block title %}Posts — Admin{% endblock %}

{% block body %}
    <h1>📝 Posts</h1>
    <p>
        <a href="{{ path('admin_dashboard') }}">← Dashboard</a> |
        <a href="{{ path('admin_post_new') }}">➕ New Post</a> |
        <a href="{{ path('logout') }}">Logout</a>
    </p>

    {% for message in app.flashes('success') %}
        <div style="background:#c6f6d5; color:#22543d; padding:0.75rem 1rem; border-radius:6px; margin-bottom:1rem;">✅ {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div style="background:#fed7d7; color:#9b2c2c; padding:0.75rem 1rem; border-radius:6px; margin-bottom:1rem;">❌ {{ message }}</div>
    {% endfor %}

    <div style="background:var(--card-bg); padding:1rem; border-radius:8px; margin-bottom:2rem; border:1px solid var(--border);">
        <strong>🔗 Generate article from URL</strong>
        <form method="post" action="{{ path('admin_post_fetch_url') }}" style="display:flex; gap:0.5rem; margin-top:0.5rem;">
            <input type="url" name="url" placeholder="https://example.com/article" required style="flex:1; padding:0.5rem; border:1px solid var(--border); border-radius:4px; background:var(--bg); color:var(--fg);">
            <input type="hidden" name="_token" value="{{ csrf_token('fetch_url') }}">
            <button type="submit" style="padding:0.5rem 1rem; background:var(--accent); color:white; border:none; border-radius:4px; cursor:pointer; font-weight:bold;">Generate</button>
        </form>
    </div>

    <table style="width:100%; border-collapse:collapse;">
        <tr style="background:var(--card-bg);">
            <th style="text-align:left; padding:0.6rem; border:1px solid var(--border);">Title</th>
            <th style="text-align:left; padding:0.6rem; border:1px solid var(--border); width:90px;">Status</th>
            <th style="text-align:left; padding:0.6rem; border:1px solid var(--border); width:120px;">Created</th>
            <th style="text-align:left; padding:0.6rem; border:1px solid var(--border); width:200px;">Actions</th>
        </tr>
        {% for post in posts %}
            <tr>
                <td style="padding:0.6rem; border:1px solid var(--border);">
                    <strong>{{ post.title|length > 60 ? post.title[:60] ~ '…' : post.title }}</strong>
                    {% if post.auto_generated %}<span title="AI generated" style="font-size:0.75rem;">🤖</span>{% endif %}
                </td>
                <td style="padding:0.6rem; border:1px solid var(--border);">
                    <span style="padding:0.15rem 0.4rem; border-radius:3px; font-size:0.75rem; background:{{ post.status == 'published' ? '#c6f6d5' : '#fed7d7' }}; color:{{ post.status == 'published' ? '#22543d' : '#9b2c2c' }};">
                        {{ post.status == 'published' ? '✓ PUB' : '○ DRAFT' }}
                    </span>
                </td>
                <td style="padding:0.6rem; border:1px solid var(--border); font-size:0.8rem; color:var(--muted);">
                    {{ post.created_at|date('Y-m-d H:i') }}
                </td>
                <td style="padding:0.6rem; border:1px solid var(--border); font-size:0.85rem;">
                    <a href="{{ path('admin_post_edit', {id: post.id}) }}">Edit</a> |
                    <form method="post" action="{{ path('admin_post_toggle', {id: post.id}) }}" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ post.id) }}">
                        <button type="submit" style="background:none; border:none; color:var(--accent); cursor:pointer; padding:0; font:inherit; text-decoration:underline;">
                            {{ post.status == 'published' ? 'Hide' : 'Publish' }}
                        </button>
                    </form> |
                    <form method="post" action="{{ path('admin_post_delete', {id: post.id}) }}" style="display:inline;" onsubmit="return confirm('Delete this post?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                        <button type="submit" style="background:none; border:none; color:#e53e3e; cursor:pointer; padding:0; font:inherit; text-decoration:underline;">Delete</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4" style="padding:1.5rem; border:1px solid var(--border); text-align:center; color:var(--muted);">No posts yet. Add one or generate from URL above.</td></tr>
        {% endfor %}
    </table>
{% endblock %}

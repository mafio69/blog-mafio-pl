{% extends 'base.html.twig' %}

{% block title %}RSS Feeds — Admin{% endblock %}

{% block body %}
    <h1>RSS Feeds</h1>
    <p>
        <a href="{{ path('admin_dashboard') }}">← Dashboard</a> |
        <a href="{{ path('admin_feed_new') }}">➕ Add New Source</a> |
        <a href="{{ path('logout') }}">Logout</a>
    </p>

    <table style="width:100%; border-collapse:collapse; margin-bottom:2rem;">
        <tr style="background:#f0f0f0;">
            <th style="text-align:left; padding:0.5rem; border:1px solid #ddd;">Name</th>
            <th style="text-align:left; padding:0.5rem; border:1px solid #ddd;">Category</th>
            <th style="text-align:left; padding:0.5rem; border:1px solid #ddd;">Status</th>
            <th style="text-align:left; padding:0.5rem; border:1px solid #ddd;">Last Fetched</th>
            <th style="text-align:left; padding:0.5rem; border:1px solid #ddd;">Actions</th>
        </tr>
        {% for feed in feeds %}
            {% if feed is iterable and feed.name is defined %}
                <tr>
                    <td>{{ feed.name }}</td>
                    <td>{{ feed.category|default('') }}</td>
                    <td>{{ feed.active ? 'ACTIVE' : 'INACTIVE' }}</td>
                    <td>{{ feed.last_fetched_at ? feed.last_fetched_at|date('Y-m-d H:i') : 'Never' }}</td>
                    <td>
                        <a href="{{ path('admin_feed_edit', {id: feed.id}) }}">Edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Invalid feed data</td>
                </tr>
            {% endif %}
        {% endfor %}
    </table>
{% endblock %}

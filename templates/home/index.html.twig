{% extends 'base.html.twig' %}

{% block title %}blog.mafio.pl — Tech & AI{% endblock %}

{% block body %}
    {% if posts|length > 0 %}
        {% set all_tags = [] %}
        {% for post in posts %}
            {% if post is iterable and post.tags is defined %}
                {% for tag in post.tags|default([]) %}
                    {% if tag not in all_tags %}
                        {% set all_tags = all_tags|merge([tag]) %}
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endfor %}

        {% if all_tags|length > 0 %}
            <div class="filter-bar" id="filter-bar">
                <span class="label">filtr:</span>
                <span class="tag active" data-tag="all" onclick="filterByTag('all')">all</span>
                {% for tag in all_tags|sort %}
                    <span class="tag" data-tag="{{ tag }}" onclick="filterByTag('{{ tag }}')">{{ tag }}</span>
                {% endfor %}
            </div>
        {% endif %}

        <div class="posts-grid" id="posts-list">
            {% for post in posts %}
                {% if post is iterable and post.slug is defined %}
                    <a href="{{ path('post_show', {slug: post.slug}) }}" class="post-card" data-slug="{{ post.slug }}" data-tags="{{ post.tags|default([])|join(',') }}">
                        <div class="post-card-date">{{ post.published_at|date('d.m.Y') }}{% if post.auto_generated %} · 🤖{% endif %}</div>
                        <div class="post-card-title">{{ post.title }}</div>
                        {% if post.summary %}
                            <div class="post-card-summary">{{ post.summary|length > 180 ? post.summary[:180] ~ '…' : post.summary }}</div>
                        {% endif %}
                        <div class="post-card-footer">
                            <div class="tags">
                                {% for tag in post.tags|default([]) %}
                                    <span class="tag">{{ tag }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    {% else %}
        <div style="text-align: center; padding: 6rem 0;">
            <p style="font-size: 1.2rem; margin-bottom: 0.5rem; text-shadow: 0 0 12px #33ff3360;">_</p>
            <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 1rem;">Wkrótce...</h2>
            <p style="font-size: 0.8rem; color: var(--fg-muted); max-width: 400px; margin: 0 auto;">
                Auto-agregowane artykuły ze świata PHP, Docker i DevOps — podsumowane przez AI.
            </p>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
<script>
(function() {
    function getReadSlugs() {
        var m = document.cookie.match(/(?:^|; )read_posts=([^;]*)/);
        return m ? JSON.parse(decodeURIComponent(m[1])) : [];
    }
    function markRead(slug) {
        var s = getReadSlugs();
        if (s.indexOf(slug) === -1) {
            s.push(slug);
            document.cookie = 'read_posts=' + encodeURIComponent(JSON.stringify(s)) + ';path=/;max-age=31536000;SameSite=Lax';
        }
    }
    var read = getReadSlugs();
    document.querySelectorAll('.post-card').forEach(function(c) {
        var slug = c.getAttribute('data-slug');
        if (read.indexOf(slug) !== -1) {
            c.classList.add('is-read');
            var f = c.querySelector('.post-card-footer');
            if (f) { var b = document.createElement('span'); b.className='read-badge'; b.textContent='✓'; f.appendChild(b); }
        }
        c.addEventListener('click', function() { markRead(slug); });
    });
    window.filterByTag = function(tag) {
        document.querySelectorAll('#filter-bar .tag').forEach(function(t) {
            t.classList.toggle('active', t.getAttribute('data-tag') === tag);
        });
        document.querySelectorAll('.post-card').forEach(function(c) {
            c.style.display = (tag === 'all' || c.getAttribute('data-tags').split(',').indexOf(tag) !== -1) ? '' : 'none';
        });
    };
})();
</script>
{% endblock %}

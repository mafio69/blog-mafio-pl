{% extends 'base.html.twig' %}

{% block title %}blog.mafio.pl — Tech Blog{% endblock %}

{% block body %}
    {% for post in posts %}
        <article>
            <div class="post-meta">
                {{ post.published_at|date('F d, Y') }}
                {% if post.auto_generated %}
                    &bull; <span title="Summarized by Gemini AI">🤖 AI Generated</span>
                {% endif %}
            </div>
            
            <h2 class="post-title">
                <a href="#">{{ post.title }}</a>
            </h2>
            
            {% if post.summary %}
                <p class="post-summary">{{ post.summary }}</p>
            {% endif %}
            
            <div class="tags">
                {% for tag in post.tags %}
                    <span class="tag">{{ tag }}</span>
                {% endfor %}
            </div>
        </article>
    {% else %}
        <div style="text-align: center; padding: 4rem 0;">
            <p style="font-size: 1.25rem; color: var(--muted);">No posts yet. Check back soon!</p>
        </div>
    {% endfor %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} — blog.mafio.pl{% endblock %}

{% block body %}
    <article>
        <div style="margin-bottom: 2rem;">
            <div style="font-size: 0.7rem; color: var(--fg-muted); margin-bottom: 1rem;">
                {{ post.published_at|date('d.m.Y') }}{% if post.auto_generated %} · 🤖 AI{% endif %}
            </div>
            <h1 style="font-size: 1.6rem; font-weight: 800; line-height: 1.3; margin-bottom: 1rem;">{{ post.title }}</h1>
            <div class="tags">
                {% for tag in post.tags|default([]) %}
                    <span class="tag">{{ tag }}</span>
                {% endfor %}
            </div>
        </div>

        <div class="article-content">
            {{ post.content|nl2br }}
        </div>

        {% if post.source_urls is defined and post.source_urls|length > 0 %}
            <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); font-size: 0.75rem; color: var(--fg-muted);">
                źródło:
                {% for url in post.source_urls %}
                    <a href="{{ url }}" target="_blank" rel="noopener" style="color: var(--fg-dim);">{{ url|length > 50 ? url[:50] ~ '…' : url }}</a>{{ not loop.last ? ' · ' : '' }}
                {% endfor %}
            </div>
        {% endif %}
    </article>

    <div style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <a href="{{ path('home') }}" style="color: var(--fg-muted); text-decoration: none; font-size: 0.8rem;">← wróć</a>
    </div>
{% endblock %}

{% block javascripts %}
<script>
(function() {
    var slug = '{{ post.slug }}';
    var m = document.cookie.match(/(?:^|; )read_posts=([^;]*)/);
    var s = m ? JSON.parse(decodeURIComponent(m[1])) : [];
    if (s.indexOf(slug) === -1) { s.push(slug); document.cookie = 'read_posts=' + encodeURIComponent(JSON.stringify(s)) + ';path=/;max-age=31536000;SameSite=Lax'; }
})();
</script>
{% endblock %}

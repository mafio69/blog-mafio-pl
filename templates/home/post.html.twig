{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} — blog.mafio.pl{% endblock %}

{% block body %}
    <article>
        <div class="post-meta" style="margin-bottom: 1rem;">
            {{ post.published_at|date('d M Y') }}
            {% if post.auto_generated %}
                &bull; 🤖 AI Generated
            {% endif %}
        </div>

        <h1 style="font-size: 2rem; font-weight: 800; line-height: 1.2; margin-bottom: 1.5rem;">{{ post.title }}</h1>

        <div class="tags" style="margin-bottom: 2rem;">
            {% for tag in post.tags|default([]) %}
                <span class="tag">{{ tag }}</span>
            {% endfor %}
        </div>

        <div style="font-size: 1.05rem; line-height: 1.8; color: var(--fg);">
            {{ post.content|nl2br }}
        </div>

        {% if post.source_urls is defined and post.source_urls|length > 0 %}
            <div style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--muted);">
                <strong>Source:</strong>
                {% for url in post.source_urls %}
                    <a href="{{ url }}" target="_blank" rel="noopener" style="color: var(--accent);">{{ url|length > 60 ? url[:60] ~ '…' : url }}</a>{{ not loop.last ? ', ' : '' }}
                {% endfor %}
            </div>
        {% endif %}
    </article>

    <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <a href="{{ path('home') }}" style="color: var(--accent); text-decoration: none; font-weight: 500;">← Back to all articles</a>
    </div>
{% endblock %}

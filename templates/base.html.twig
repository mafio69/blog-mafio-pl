<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}blog.mafio.pl — Tech & AI{% endblock %}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0a0a0a;
            --bg-elevated: #111111;
            --bg-hover: #1a1a1a;
            --fg: #33ff33;
            --fg-dim: #22cc22;
            --fg-muted: #1a9a1a;
            --accent: #33ff33;
            --accent-dim: #22cc22;
            --border: #1a1a1a;
            --border-hover: #2a2a2a;
            --tag-bg: #0d2a0d;
            --tag-color: #33ff33;
            --font: 'JetBrains Mono', 'Courier New', monospace;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--fg);
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
        }

        ::selection { background: #33ff3330; color: #33ff33; }

        .container {
            max-width: 1080px;
            margin: 0 auto;
            padding: 0 1.5rem;
            width: 100%;
        }

        /* Header — Vercel style: minimal top bar */
        .site-header {
            border-bottom: 1px solid var(--border);
            padding: 0.9rem 0;
            position: sticky;
            top: 0;
            background: var(--bg);
            z-index: 100;
            backdrop-filter: blur(8px);
        }

        .site-header .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .site-logo {
            font-size: 1.1rem;
            font-weight: 800;
            text-decoration: none;
            color: var(--fg);
            letter-spacing: -0.02em;
        }

        .site-logo .dot { opacity: 0.4; }

        .site-nav {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .site-nav a {
            color: var(--fg-muted);
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 500;
            transition: color 0.15s;
        }

        .site-nav a:hover { color: var(--fg); }

        /* Main */
        main { flex: 1; padding: 3rem 0; }

        /* Section headers */
        .section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--fg-muted);
            font-weight: 700;
            margin-bottom: 1.5rem;
        }

        /* Post cards — Vercel grid style */
        .posts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1px;
            background: var(--border);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
        }

        .post-card {
            display: flex;
            flex-direction: column;
            padding: 1.5rem;
            background: var(--bg);
            text-decoration: none;
            color: inherit;
            transition: background 0.15s;
        }

        .post-card:hover { background: var(--bg-hover); }
        .post-card.is-read { opacity: 0.45; }

        .post-card-date {
            font-size: 0.7rem;
            color: var(--fg-muted);
            margin-bottom: 0.6rem;
        }

        .post-card-title {
            font-size: 0.95rem;
            font-weight: 700;
            line-height: 1.4;
            margin-bottom: 0.5rem;
            color: var(--fg);
        }

        .post-card-summary {
            font-size: 0.78rem;
            color: var(--fg-dim);
            line-height: 1.5;
            margin-bottom: 0.75rem;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            flex: 1;
        }

        .post-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
        }

        .post-card-meta {
            font-size: 0.65rem;
            color: var(--fg-muted);
        }

        .read-badge {
            font-size: 0.6rem;
            color: var(--fg-muted);
            border: 1px solid var(--border-hover);
            padding: 0.1rem 0.4rem;
            border-radius: 3px;
        }

        @media (max-width: 700px) {
            .posts-grid { grid-template-columns: 1fr; }
        }

        /* Tags */
        .tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }

        .tag {
            font-size: 0.6rem;
            background: var(--tag-bg);
            color: var(--tag-color);
            padding: 0.15rem 0.45rem;
            border-radius: 3px;
            font-weight: 500;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid transparent;
            transition: border-color 0.15s;
        }

        .tag:hover { border-color: var(--fg-muted); }
        .tag.active { border-color: var(--fg); }

        /* Filter bar */
        .filter-bar {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
            align-items: center;
            margin-bottom: 2rem;
        }

        .filter-bar .label {
            font-size: 0.7rem;
            color: var(--fg-muted);
            margin-right: 0.5rem;
        }

        /* Footer */
        .site-footer {
            border-top: 1px solid var(--border);
            padding: 1.5rem 0;
            font-size: 0.7rem;
            color: var(--fg-muted);
        }

        .site-footer .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .site-footer a { color: var(--fg-dim); text-decoration: none; }
        .site-footer a:hover { color: var(--fg); }

        @media (max-width: 600px) {
            .site-footer .container { flex-direction: column; gap: 0.5rem; }
        }

        /* Article page */
        .article-content {
            font-size: 0.9rem;
            line-height: 1.9;
            color: var(--fg-dim);
            max-width: 680px;
        }

        .article-content p { margin-bottom: 1.5rem; }

        /* CRT glow effect on headings */
        h1, .post-card-title {
            text-shadow: 0 0 8px #33ff3340;
        }
    </style>
    {% block head %}{% endblock %}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KHG8Y9DCJ6"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-KHG8Y9DCJ6');
    </script>
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a href="{{ path('home') }}" class="site-logo">blog<span class="dot">.</span>mafio<span class="dot">.</span>pl</a>
            <nav class="site-nav">
                <a href="{{ path('home') }}">Artykuły</a>
                <a href="{{ path('newsletter_index') }}">Newsletter</a>
                <a href="{{ path('admin_dashboard') }}">Admin</a>
            </nav>
        </div>
    </header>

    <main>
        <div class="container">
            {% for message in app.flashes('error') %}
                <div style="background: #fed7d7; color: #9b2c2c; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; border: 1px solid #feb2b2;">
                    ⚠ {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('success') %}
                <div style="background: #c6f6d5; color: #22543d; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; border: 1px solid #9ae6b4;">
                    ✓ {{ message }}
                </div>
            {% endfor %}
            {% block body %}{% endblock %}
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <span>© {{ "now"|date("Y") }} blog.mafio.pl</span>
            <span>Symfony 8 · Supabase · Kiro · Gemini AI</span>
        </div>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}blog.mafio.pl{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&family=JetBrains+Mono&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #ffffff;
            --fg: #1a202c;
            --muted: #718096;
            --accent: #3182ce;
            --border: #e2e8f0;
            --card-bg: #f8fafc;
            --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #0f172a;
                --fg: #f1f5f9;
                --muted: #94a3b8;
                --accent: #60a5fa;
                --border: #1e293b;
                --card-bg: #1e293b;
            }
        }

        * { box-sizing: border-box; }
        body {
            font-family: var(--font-sans);
            background-color: var(--bg);
            color: var(--fg);
            line-height: 1.6;
            margin: 0;
            padding: 0;
            transition: background-color 0.3s, color 0.3s;
        }

        .container {
            max-width: 720px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }

        header {
            margin-bottom: 4rem;
            text-align: center;
        }

        header h1 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            letter-spacing: -0.025em;
        }

        header p {
            color: var(--muted);
            font-size: 1.1rem;
        }

        .nav-links {
            margin-top: 1rem;
            font-size: 0.9rem;
        }

        .nav-links a {
            color: var(--accent);
            text-decoration: none;
            margin: 0 0.5rem;
        }

        .nav-links a:hover { text-decoration: underline; }

        article {
            margin-bottom: 3rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid var(--border);
        }

        article:last-child { border-bottom: none; }

        .post-meta {
            font-size: 0.85rem;
            color: var(--muted);
            margin-bottom: 0.5rem;
            font-family: var(--font-mono);
        }

        .post-title {
            font-size: 1.75rem;
            font-weight: 700;
            margin: 0 0 1rem 0;
            line-height: 1.2;
        }

        .post-title a {
            color: inherit;
            text-decoration: none;
        }

        .post-title a:hover { color: var(--accent); }

        .post-summary {
            font-size: 1.05rem;
            color: var(--fg);
            margin-bottom: 1.5rem;
            opacity: 0.9;
        }

        .tags {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .tag {
            font-size: 0.75rem;
            background: var(--card-bg);
            color: var(--muted);
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
        }

        footer {
            margin-top: 5rem;
            padding: 2rem 0;
            text-align: center;
            font-size: 0.85rem;
            color: var(--muted);
            border-top: 1px solid var(--border);
        }

        /* Utils */
        .text-accent { color: var(--accent); }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1><a href="{{ path('home') }}" style="color: inherit; text-decoration: none;">blog.<span class="text-accent">mafio</span>.pl</a></h1>
            <p>Tech, PHP, Docker & Automation</p>
            <div class="nav-links">
                <a href="{{ path('home') }}">Home</a>
                <a href="#">About</a>
                <a href="{{ path('admin_dashboard') }}">Admin</a>
            </div>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer>
            &copy; {{ "now"|date("Y") }} blog.mafio.pl &bull; Built with Symfony 8 & Supabase
        </footer>
    </div>
</body>
</html>

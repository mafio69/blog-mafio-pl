{% extends 'base.html.twig' %}

{% block title %}{{ status_code }} — Wystąpił błąd{% endblock %}

{% block body %}
<div style="text-align: center; padding: 4rem 2rem; max-width: 600px; margin: 0 auto;">
    <div style="font-size: 8rem; line-height: 1; margin-bottom: 1rem; opacity: 0.3;">⚙️</div>
    
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 1rem; letter-spacing: -0.02em;">
        Coś poszło nie tak
    </h1>
    
    <p style="font-size: 1rem; color: var(--fg-muted); margin-bottom: 2rem; line-height: 1.6;">
        Pracujemy nad rozwiązaniem tego problemu. <br>
        Spróbuj odświeżyć stronę lub wrócić później.
    </p>
    
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="{{ path('home') }}" 
           style="display: inline-block; padding: 0.8rem 1.5rem; background: var(--accent); color: white; 
                  text-decoration: none; border-radius: 6px; font-weight: 700; font-size: 0.9rem; 
                  transition: background 0.15s;">
            ← Wróć na stronę główną
        </a>
        
        <a href="javascript:history.back()" 
           style="display: inline-block; padding: 0.8rem 1.5rem; background: var(--bg-elevated); color: var(--fg); 
                  text-decoration: none; border: 1px solid var(--border-hover); border-radius: 6px; 
                  font-weight: 700; font-size: 0.9rem; transition: border-color 0.15s;">
            ← Wstecz
        </a>
    </div>
    
    <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border);">
        <p style="font-size: 0.8rem; color: var(--fg-muted);">
            Kod błędu: {{ status_code }} {{ status_text }}
        </p>
    </div>
</div>
{% endblock %}